<h1><%= title %></h1>
<%- messages() %>

<% if (errors && errors.length > 0) { %>
    <ul class="form-errors">
        <% errors.forEach(err => { %>
            <li><%= err.msg %></li>
        <% }) %>
    </ul>
<% } %>

<div class="my-form">
	<form id="updateForm" method="POST" action="/inv/edit/<%= inv_id %>">
        <div>All Fields are required.</div>
        <div>
            <label>Classification:<br>
                <%- classificationList %>
            </label>
        </div>
        <div>
            <label>Make:<br>
            <input type="text" name="inv_make" required value="<%= inv_make %>" minlength="3" placeholder="Min of 3 characters">
            </label>
        </div>
		<div>
            <label>Model:<br>
            <input type="text" name="inv_model" required value="<%= inv_model %>" minlength="3" placeholder="Min of 3 characters">
            </label>
        </div>
        <div>
            <label>Description:<br>
            <textarea name="inv_description" required placeholder="Enter vehicle description..."><%- inv_description %></textarea>
            </label>
        </div>
        <div>
            <label>Image Path:<br>
            <input type="text" name="inv_image" required value="<%- inv_image || '/images/vehicles/no-image.png' %>">
            </label>
        </div>
        <div>
            <label>Thumbnail Path:<br>
            <input type="text" name="inv_thumbnail" required value="<%- inv_thumbnail || '/images/vehicles/no-image-tn.png' %>">
            </label>
        </div>
        <div>
            <label>Price:<br>
            <input type="number" name="inv_price" required value="<%= inv_price %>" step="0.01" min="0" placeholder="Decimal or Integer">
            </label>
        </div>
        <div>
            <label>Year:<br>
            <input type="number" name="inv_year" required value="<%= inv_year %>" min="1000" max="9999" placeholder="4-digit year">
            </label>
        </div>
        <div>
            <label>Miles:<br>
            <input type="number" name="inv_miles" required value="<%= inv_miles %>" min="0" step="1" placeholder="Digits only">
            </label>
        </div>
        <div>
            <label>Color:<br>
            <input type="text" name="inv_color" required value="<%- inv_color %>" minlength="2">
            </label>
        </div> 
		<button type="submit" disabled>Update Vehicle</button>
        <input type="hidden" name="inv_id"
        <% if(locals.inv_id) { %> value="<%= locals.inv_id %>"
        <% } %>>
	</form>
</div>
<script src="../../js/edit-inventory.js"></script>
